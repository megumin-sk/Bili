<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bilibili.mapper.AddressMapper">
<resultMap id="addressMap" type="com.bilibili.entity.Address">
    <id property="addressId" column="address_id"/>
    <result property="comment" column="address_comment"/>
    <result property="addressName" column="address_name"/>
    <result property="nickName" column="nick_name"/>
    <result property="userId" column="user_id"/>
</resultMap>
    <select id="queryAll" resultMap="addressMap">
        select * from order_address
        where user_id = #{userId}
    </select>
</mapper>