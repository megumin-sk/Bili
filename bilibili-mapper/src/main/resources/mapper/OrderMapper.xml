<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bilibili.mapper.OrderMapper">
<resultMap id="OrderMap" type="com.bilibili.entity.OrderItem">
    <id property="orderId" column="order_id"/>
    <id property="userId" column="user_id"/>
    <id property="productName" column="product_name"/>
    <id property="buyNum" column="buy_num"/>
    <id property="price" column="order_price"/>
    <id property="createTime" column="create_time"/>
    <id property="status" column="status"/>
</resultMap>
    <insert id="addOrder">
        insert into order_item(order_user_id,product_id,buy_num,order_create_time,order_price) values(#{userId},#{productId},#{buyNum},#{createTime},#{price})
    </insert>
    <update id="update">
        update order_item
        <set>
            <if test="userId != null">
                order_user_id = #{userId},
            </if>
            <if test="productName != null">
                product_name = #{productName},
            </if>
            <if test="price != null">
                order_price = #{price},
            </if>
            <if test="createTime != null">
                order_create_time = #{createTime},
            </if>
            <if test="status != null">
                status = #{status},
            </if>
            <if test="buyNum != null">
                buy_num = #{buyNum},
            </if>
        </set>
        where order_id = #{orderId}
    </update>
    <select id="queryById" resultMap="OrderMap">
        select * from order_item
        where product_id=#{productId} and order_user_id=#{userId}
    </select>
    <select id="queryIds" resultType="java.lang.Integer">
        select order_item.product_id from order_item
        where order_user_id=#{userId}
    </select>
</mapper>