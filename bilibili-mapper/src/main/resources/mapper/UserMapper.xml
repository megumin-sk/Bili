<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bilibili.mapper.UserMapper">
    <resultMap id="UserMap" type="com.bilibili.entity.User">
        <id property="id" column="user_id"/>
        <result property="name" column="nick_name"/>
        <result property="password" column="password"/>
        <result property="imgUrl" column="img_url"/>
        <result property="sex" column="sex"/>
        <result property="birthday" column="birthday"/>
        <result property="school" column="school"/>
        <result property="introduction" column="person_introduction"/>
        <result property="joinTime" column="join_time"/>
        <result property="lastLoginTime" column="last_login_time"/>
        <result property="lastLoginIp" column="last_login_ip"/>
        <result property="status" column="status"/>
        <result property="notice" column="notice_info"/>
    </resultMap>
    <insert id="register">
    </insert>
    <update id="updateUser">
        update user_info
        <set>
            <if test="name != null">
                nick_name = #{name},
            </if>
            <if test="password != null">
                password = #{password},
            </if>
            <if test="sex != null">
                sex = #{sex},
            </if>
            <if test="birthday != null">
                birthday = Date(#{birthday}),
            </if>
            <if test="school != null">
                school = #{school},
            </if>
            <if test="introduction != null">
                person_introduction = #{introduction},
            </if>
            <if test="notice != null">
                notice_info = #{notice},
            </if>
            <if test="status != null">
                status = #{status},
            </if>
            <if test="lastLoginIp != null">
                last_login_ip = #{lastLoginIp},
            </if>
            <if test="lastLoginTime != null">
                last_login_time = #{lastLoginTime},
            </if>
            <if test="joinTime != null">
                join_time = #{joinTime},
            </if>
            <if test="imgUrl != null">
                img_url = #{imgUrl},
            </if>
        </set>
        where user_id = #{id}
    </update>
    <select id="login" resultMap="UserMap">
        select user_id,password,img_url from user_info
        where nick_name = #{name}
    </select>
    <select id="queryUserById" resultMap="UserMap">
        SELECT * FROM user_info
        WHERE user_id = #{id}
    </select>
</mapper>